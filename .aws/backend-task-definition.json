{
  "family": "snakeai-backend",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::661390316383:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::661390316383:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "661390316383.dkr.ecr.eu-north-1.amazonaws.com/snakeai/backend:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/snakeai-service",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096"
}
