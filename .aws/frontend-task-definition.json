{
  "family": "snakeai-frontend",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::661390316383:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "661390316383.dkr.ecr.eu-north-1.amazonaws.com/snakeai/frontend:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/snakeai-service",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
